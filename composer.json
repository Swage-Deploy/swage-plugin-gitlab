{
    "name": "swage/gitlab",
    "description": "GitLab source control provider for Swage, for GitLab.com and self-hosted GitLab.",
    "type": "swage-plugin",
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "laravel/framework": "^13.0",
        "laravel/socialite": "^5.12"
    },
    "autoload": {
        "psr-4": {
            "Swage\\GitLab\\": "src/"
        }
    },
    "extra": {
        "swage": {
            "kind": "source-control",
            "contract": 1
        },
        "laravel": {
            "providers": [
                "Swage\\GitLab\\GitLabServiceProvider"
            ]
        }
    }
}
